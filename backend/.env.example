# Backend Environment Variables
# Copy this file to .env and fill in the values before running the server.

# Server
PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/sel_reflection

# JWT secrets (use long random strings in production)
JWT_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret

# Session secret
SESSION_SECRET=replace-with-a-session-secret

# Google OAuth 2.0 (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email / Nodemailer
EMAIL_USER=
EMAIL_PASSWORD=
